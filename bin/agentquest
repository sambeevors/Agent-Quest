#!/usr/bin/env bash
# agentquest — the pre-rebrand name of `pokeagent`, kept so existing
# ~/.local/bin/agentquest symlinks still work. Re-run install.sh (or symlink
# bin/pokeagent) to switch to the new command.
set -euo pipefail

# Follows symlinks portably (macOS has no `readlink -f`).
resolve_symlink() {
  local src="$1"
  while [[ -L "$src" ]]; do
    local dir
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$src")" && pwd)" "$(basename "$src")"
}

printf 'agentquest is now pokeagent; this alias will go away.\n' >&2
exec "$(dirname "$(resolve_symlink "${BASH_SOURCE[0]}")")/pokeagent" "$@"
